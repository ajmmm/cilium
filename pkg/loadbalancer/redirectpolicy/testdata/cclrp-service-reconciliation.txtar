# Verify that ServiceMatcher mappings are materialized and reconciled when
# Service and EndpointSlice state changes.

hive start

k8s/add pod.yaml service.yaml endpointslice.yaml
k8s/add cclrp.yaml
db/cmp localredirectmappings mappings-initial.table
db/cmp frontends frontends-initial.table
db/cmp backends backends-initial.table

# Changing EndpointSlice ports and addresses updates inherited mappings and
# the CCLRP local backends.
k8s/update service-target-updated.yaml endpointslice-target-updated.yaml
db/cmp localredirectmappings mappings-target-updated.table
db/cmp frontends frontends-target-updated.table
db/cmp backends backends-target-updated.table

# Removing a Service port removes its mapping and frontend redirect.
k8s/update service-no-dns.yaml endpointslice-no-dns.yaml
db/cmp localredirectmappings mappings-no-dns.table
db/cmp frontends frontends-no-dns.table
db/cmp backends backends-no-dns.table

# Removing the policy and Service removes all remaining CCLRP state.
k8s/delete cclrp.yaml service-no-dns.yaml endpointslice-no-dns.yaml pod.yaml
db/cmp localredirectmappings mappings-empty.table
db/cmp frontends frontends-empty.table
db/cmp backends backends-empty.table

# ---

