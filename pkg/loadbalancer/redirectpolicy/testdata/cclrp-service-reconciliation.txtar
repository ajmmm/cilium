-- pod.yaml --
apiVersion: v1
kind: Pod
metadata:
  name: proxy
  namespace: test
  labels:
    app: proxy
spec:
  nodeName: testnode
  containers:
  - name: proxy
    image: nginx
status:
  hostIP: 172.19.0.3
  phase: Running
  podIP: 10.244.2.1
  podIPs:
  - ip: 10.244.2.1
  conditions:
  - status: "True"
    type: Ready

-- service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: echo
  namespace: test
spec:
  type: ClusterIP
  clusterIP: 169.254.169.254
  ports:
  - name: http
    port: 8080
    protocol: TCP
    targetPort: 80
  - name: https
    port: 8443
    protocol: TCP
    targetPort: 443
  - name: dns
    port: 5353
    protocol: UDP
    targetPort: 5353

-- service-target-updated.yaml --
