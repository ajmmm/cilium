# A CCLRP ServiceMatcher takes precedence over a CLRP matching the same Service.

hive start

k8s/add pod.yaml service.yaml endpointslice.yaml
k8s/add lrp.yaml
db/cmp frontends frontends-lrp.table

k8s/add cclrp.yaml
db/cmp frontends frontends-cclrp.table
db/cmp backends backends-cclrp.table

# Removing the CCLRP releases the claim and lets CLRP restore the redirect.
k8s/delete cclrp.yaml
db/cmp frontends frontends-lrp.table

# ---

-- pod.yaml --
apiVersion: v1
kind: Pod
metadata:
  name: proxy
  namespace: test
  labels:
    app: proxy
spec:
  nodeName: testnode
  containers:
  - name: proxy
    image: nginx
status:
  hostIP: 172.19.0.3
  phase: Running
  podIP: 10.244.2.1
  podIPs:
  - ip: 10.244.2.1
  conditions:
  - status: "True"
    type: Ready

-- service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: echo
  namespace: test
spec:
  type: ClusterIP
  clusterIP: 169.254.169.254
  ports:
  - name: http
    port: 8080
    protocol: TCP
    targetPort: 80

-- endpointslice.yaml --
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  labels:
    kubernetes.io/service-name: echo
  name: echo-v4
  namespace: test
addressType: IPv4
endpoints:
- addresses:
  - 10.244.1.1
  conditions:
    ready: true
ports:
- name: http
  port: 80
  protocol: TCP

-- lrp.yaml --
apiVersion: cilium.io/v2
kind: CiliumLocalRedirectPolicy
metadata:
  name: legacy
  namespace: test
spec:
  redirectFrontend:
    serviceMatcher:
      serviceName: echo
      namespace: test
  redirectBackend:
    localEndpointSelector:
      matchLabels:
        app: proxy
    toPorts:
    - port: "80"
      name: http
      protocol: TCP

-- cclrp.yaml --
apiVersion: cilium.io/v2
kind: CiliumClusterwideLocalRedirectPolicy
metadata:
  name: clusterwide
spec:
  serviceMatcher:
    namespace: test
    serviceName: echo
  localEndpointSelector:
    matchLabels:
      app: proxy
  ports:
  - port: "8080"
    targetPort: "80"
    protocol: TCP

-- frontends-lrp.table --
Address                    Type       ServiceName   PortName  Backends              RedirectTo                              Status
169.254.169.254:8080/TCP   ClusterIP  test/echo     http      10.244.2.1:80/TCP     test/legacy:local-redirect              Done

-- frontends-cclrp.table --
Address                    Type       ServiceName   PortName  Backends              RedirectTo                              Status
169.254.169.254:8080/TCP   ClusterIP  test/echo     http      10.244.2.1:80/TCP     cilium/cclrp-clusterwide:local-redirect Done

-- backends-cclrp.table --
Service                                  Address            NodeName
cilium/cclrp-clusterwide:local-redirect  10.244.2.1:80/TCP
test/echo                                10.244.1.1:80/TCP
test/legacy:local-redirect               10.244.2.1:80/TCP
