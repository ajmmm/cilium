-- service.yaml --
apiVersion: v1
kind: Service
metadata:
  name: kube-dns
  namespace: kube-system
spec:
  type: ClusterIP
  clusterIP: 10.96.0.10
  ports:
  - name: dns
    port: 53
    protocol: UDP
    targetPort: 53
  - name: dns-tcp
    port: 53
    protocol: TCP
    targetPort: 53
  - name: metrics
    port: 9153
    protocol: TCP
    targetPort: 9153
  selector:
    k8s-app: kube-dns

-- endpointslice.yaml --
apiVersion: discovery.k8s.io/v1
kind: EndpointSlice
metadata:
  name: kube-dns
  namespace: kube-system
  labels:
    kubernetes.io/service-name: kube-dns
addressType: IPv4
endpoints:
- addresses:
  - 10.244.1.51
  nodeName: testnode
  conditions:
    ready: true
- addresses:
  - 10.244.1.68
  nodeName: testnode
  conditions:
    ready: true
ports:
- name: dns
  port: 53
  protocol: UDP
- name: dns-tcp
  port: 53
  protocol: TCP
- name: metrics
  port: 9153
  protocol: TCP

-- cclrp.yaml --
apiVersion: cilium.io/v2
kind: CiliumClusterwideLocalRedirectPolicy
metadata:
  name: nodelocaldns
spec:
  serviceMatcher:
    namespace: kube-system
    serviceName: kube-dns
  localEndpointSelector:
    matchLabels:
      k8s-app: node-local-dns
      io.kubernetes.pod.namespace: kube-system
  ports:
  - port: "53"
    targetPort: "53"
    protocol: TCP
  - port: "53"
    targetPort: "53"
    protocol: UDP

-- pod-1.yaml --
apiVersion: v1
kind: Pod
metadata:
  name: node-local-dns-1
  namespace: kube-system
  labels:
    k8s-app: node-local-dns
spec:
  nodeName: testnode
  containers:
  - name: node-cache
    image: node-local-dns
    ports:
    - name: dns
      containerPort: 53
      protocol: UDP
    - name: dns-tcp
      containerPort: 53
      protocol: TCP
status:
  phase: Running
  podIP: 10.244.0.225
  podIPs:
  - ip: 10.244.0.225
  conditions:
  - type: Ready
    status: "True"

