# Verify the node-local-DNS pattern with a cluster-wide local redirect policy.
# CCLRP explicitly selects the DNS Service ports and constrains the matching
# local endpoints to kube-system, leaving the Service metrics port untouched.

hive start

k8s/add service.yaml endpointslice.yaml
db/cmp frontends frontends-before.table

k8s/add cclrp.yaml pod-1.yaml
db/cmp localredirectmappings mappings-one.table
db/cmp frontends frontends-one.table
db/cmp backends backends-one.table

# A second matching local endpoint is added and appears in both DNS protocols.
k8s/add pod-2.yaml
db/cmp localredirectmappings mappings-two.table
db/cmp frontends frontends-two.table
db/cmp backends backends-two.table

# A matching Pod without the namespace constraint would be selected, but the
# explicit namespace label keeps this policy scoped to kube-system.
k8s/add pod-other-namespace.yaml
db/cmp backends backends-two.table

# Removing one local endpoint removes it from the redirected DNS frontends.
k8s/delete pod-2.yaml
db/cmp frontends frontends-one.table
db/cmp backends backends-one.table

# Removing the CCLRP restores the original Service backends and removes the
# CCLRP pseudo-service.
k8s/delete cclrp.yaml pod-1.yaml pod-other-namespace.yaml
db/cmp frontends frontends-before.table
db/cmp backends backends-service-only.table

# ---

-- mappings-one.table --
Policy       FrontendAddress              TargetPort  Status   Error
nodelocaldns 10.96.0.10:53/TCP            53/TCP      Pending
nodelocaldns 10.96.0.10:53/UDP            53/UDP      Pending

