# Verify that named-port serviceMatcher correctly fails to map to backends
# that are missing any port information.

hive start

# Add pod, service and eps for both families
k8s/add pod.yaml service.yaml eps4.yaml eps6.yaml

# Verify statedb tables
db/cmp localredirectpolicies lrp-initial.table
db/cmp services services-initial.table
db/cmp frontends frontends-initial.table
db/cmp backends backends-initial.table

# Verify service maps
lb/maps-dump lbmaps-initial.actual
* cmp lbmaps-initial.actual lbmaps-initial.expected

# Add the serviceMatcher LRP, with mismatched toPort[] entry
k8s/add lrp-svc.yaml

# Verify that despite the LRP (and a corresponding pseudo-service has been
# added) no services are redirected
db/cmp localredirectpolicies lrp-added.table
db/cmp services services-lrp.table
db/cmp frontends frontends-lrp.table
db/cmp backends backends-lrp.table

# Verify service maps
lb/maps-dump lbmaps-lrp.actual
* cmp lbmaps-lrp.actual lbmaps-lrp.expected

# Add a pod with ports specified and update the endpoints.
k8s/add pod-with-ports.yaml
k8s/update eps4-v2.yaml eps6-v2.yaml

# Verify this has redirected frontends to the second pod only.
db/cmp frontends frontends-lrp-pod2.table
db/cmp backends backends-lrp-pod2.table

# Verify service maps
lb/maps-dump lbmaps-lrp-pod2.actual
* cmp lbmaps-lrp-pod2.actual lbmaps-lrp-pod2.expected

# For fun, we'll now update with another pod that only includes
# the http port.
k8s/add pod-with-http-only.yaml
k8s/update eps4-v3.yaml eps6-v3.yaml

# Verify this has introduced another pod just on http port.
db/cmp frontends frontends-lrp-pod2-http.table
db/cmp backends backends-lrp-pod2-http.table

# Verify service maps
lb/maps-dump lbmaps-lrp-pod2-http.actual
* cmp lbmaps-lrp-pod2-http.actual lbmaps-lrp-pod2-http.expected

# Someone's bored and decides to add another pod that just provides
# https on IPv6.
k8s/add pod-with-https6-only.yaml
k8s/update eps6-v4.yaml

# Verify this has introduced another pod just on https port on IPv6.
db/cmp frontends frontends-lrp-pod2-http-https6.table
db/cmp backends backends-lrp-pod2-http-https6.table

# Verify service maps
lb/maps-dump lbmaps-lrp-pod2-http-https6.actual
* cmp lbmaps-lrp-pod2-http-https6.actual lbmaps-lrp-pod2-http-https6.expected

# Now remove the LRP
k8s/delete lrp-svc.yaml

# Verify the LRP pseudo-service is withdrawn
db/cmp localredirectpolicies lrp-initial.table
db/cmp services services-initial.table

# Verify the services are no longer being redirected
db/cmp frontends frontends-all-nolrp.table
db/cmp backends backends-all-nolrp.table

# Verify service maps
lb/maps-dump lbmaps-all-nolrp.actual
* cmp lbmaps-all-nolrp.actual lbmaps-all-nolrp.expected

