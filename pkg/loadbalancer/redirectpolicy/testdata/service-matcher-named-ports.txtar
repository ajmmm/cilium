-- lrp-svc.yaml --
apiVersion: cilium.io/v2
kind: CiliumLocalRedirectPolicy
metadata:
  name: lrp-service
  namespace: test
spec:
  redirectFrontend:
    serviceMatcher:
      serviceName: http-service
      namespace: test
  redirectBackend:
    localEndpointSelector:
      matchLabels:
        app: nginx
    toPorts:
      - name: "http"
        port: "8080"
        protocol: TCP
      - name: "https"
        port: "8443"
        protocol: TCP
