# Verify that address-based CCLRP mappings are applied to frontends and backends.

hive start

k8s/add pod.yaml cclrp.yaml
db/cmp localredirectmappings mappings-initial.table
db/cmp frontends frontends-initial.table
db/cmp backends backends-initial.table

# Changing the matching Pod updates the local redirect backends.
k8s/update pod-updated.yaml
db/cmp localredirectmappings mappings-pod-updated.table
db/cmp frontends frontends-pod-updated.table
db/cmp backends backends-pod-updated.table

# Removing the policy cleans up all CCLRP state.
k8s/delete cclrp.yaml pod-updated.yaml
db/cmp localredirectmappings mappings-empty.table
db/cmp frontends frontends-empty.table
db/cmp backends backends-empty.table

# ---

-- mappings-initial.table --
Policy   FrontendAddress                   TargetPort   Status   Error
address  169.254.169.254:8080/TCP          80/TCP       Pending
address  169.254.169.254:8443/TCP          443/TCP      Pending

-- mappings-pod-updated.table --
Policy   FrontendAddress                   TargetPort   Status  Error
address  169.254.169.254:8080/TCP          80/TCP       Done
address  169.254.169.254:8443/TCP          443/TCP      Done

-- mappings-empty.table --
Policy  FrontendAddress  TargetPort  Status  Error

-- frontends-initial.table --
Address                    Type          ServiceName                           PortName          Backends            RedirectTo  Status
169.254.169.254:8080/TCP   LocalRedirect cilium/cclrp-address:local-redirect   cclrp-8080-TCP    10.244.2.1:80/TCP               Done
169.254.169.254:8443/TCP   LocalRedirect cilium/cclrp-address:local-redirect   cclrp-8443-TCP    10.244.2.1:443/TCP              Done

-- frontends-pod-updated.table --
Address                    Type          ServiceName                           PortName          Backends            RedirectTo  Status
169.254.169.254:8080/TCP   LocalRedirect cilium/cclrp-address:local-redirect   cclrp-8080-TCP    10.244.2.2:80/TCP               Done
169.254.169.254:8443/TCP   LocalRedirect cilium/cclrp-address:local-redirect   cclrp-8443-TCP    10.244.2.2:443/TCP              Done

-- frontends-empty.table --
Address  Type  ServiceName  PortName  Backends  RedirectTo  Status

-- backends-initial.table --
Service                              Address              NodeName
cilium/cclrp-address:local-redirect  10.244.2.1:80/TCP
cilium/cclrp-address:local-redirect  10.244.2.1:443/TCP

-- backends-pod-updated.table --
Service                              Address              NodeName
cilium/cclrp-address:local-redirect  10.244.2.2:80/TCP
cilium/cclrp-address:local-redirect  10.244.2.2:443/TCP

-- backends-empty.table --
Service  Address  NodeName

-- pod.yaml --
apiVersion: v1
kind: Pod
metadata:
  name: proxy
  namespace: test
  labels:
    app: proxy
spec:
  nodeName: testnode
  containers:
  - name: proxy
    image: nginx
status:
  hostIP: 172.19.0.3
  phase: Running
  podIP: 10.244.2.1
  podIPs:
  - ip: 10.244.2.1
  conditions:
  - status: "True"
    type: Ready

-- pod-updated.yaml --
apiVersion: v1
kind: Pod
metadata:
  name: proxy
  namespace: test
  labels:
    app: proxy
spec:
  nodeName: testnode
  containers:
  - name: proxy
    image: nginx
status:
  hostIP: 172.19.0.3
  phase: Running
  podIP: 10.244.2.2
  podIPs:
  - ip: 10.244.2.2
  conditions:
  - status: "True"
    type: Ready

-- cclrp.yaml --
apiVersion: cilium.io/v2
kind: CiliumClusterwideLocalRedirectPolicy
metadata:
  name: address
spec:
  addressMatcher:
    ip: 169.254.169.254
  localEndpointSelector:
    matchLabels:
      app: proxy
  ports:
  - port: "8080"
    targetPort: "80"
    protocol: TCP
  - port: "8443"
    targetPort: "443"
    protocol: TCP
