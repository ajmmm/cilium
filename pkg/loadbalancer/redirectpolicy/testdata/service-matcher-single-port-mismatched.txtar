# Verify that single-port serviceMatcher correctly maps frontends with
# a mismatched port. The expectation is the LRP controller inserts a
# pseudo frontend for this, taking the IP of the mapped service.

hive start

# Add pod, service and eps for both families
k8s/add pod.yaml service.yaml eps-v4.yaml eps-v6.yaml

# Verify statedb tables
db/cmp localredirectpolicies lrp-initial.table
db/cmp services services-initial.table
db/cmp frontends frontends-initial.table
db/cmp backends backends-initial.table

# Verify service maps
lb/maps-dump lbmaps.initial
* cmp lbmaps.initial lbmaps-initial.expected

# Add the serviceMatcher LRP, with mismatched toPort[] entry
k8s/add lrp-svc.yaml

# Verify the LRP, pseudo-service and pseudo-frontend have been added
db/cmp localredirectpolicies lrp-added.table
db/cmp services services-lrp.table
db/cmp frontends frontends-lrp.table
db/cmp backends backends-lrp.table

# Verify service maps
lb/maps-dump lbmaps.lrp
* cmp lbmaps.lrp lbmaps-lrp.expected

# Now remove the LRP
k8s/delete lrp-svc.yaml

# Verify the pseudo-service and associated frontends is withdrawn
db/cmp localredirectpolicies lrp-initial.table
db/cmp services services-initial.table
db/cmp frontends frontends-initial.table
db/cmp backends backends-initial.table

# Verify service maps are cleaned up
lb/maps-dump lbmaps.deleted
* cmp lbmaps.deleted lbmaps-initial.expected

-- lrp-initial.table --
Name   Type   Service   FrontendType   Frontends   BackendSelector
-- lrp-added.table --
Name               Type      Service             FrontendType
test/lrp-service   service   test/http-service   svc-single-port

-- services-initial.table --
Name                Source   PortNames   TrafficPolicy   Flags
test/http-service   k8s      http=80     Cluster
-- services-lrp.table --
Name                              Source   PortNames   TrafficPolicy   Flags
test/http-service                 k8s      http=80     Cluster
test/lrp-service:local-redirect   k8s                  Cluster

-- frontends-initial.table --
Address                Type        ServiceName         PortName   Backends              RedirectTo   Status
192.168.10.10:80/TCP   ClusterIP   test/http-service   http       10.244.2.1:8080/TCP                Done
[1001::1]:80/TCP       ClusterIP   test/http-service   http       [2001::1]:8080/TCP                 Done
-- frontends-lrp.table --
Address                  Type            ServiceName                       PortName   Backends              RedirectTo   Status
192.168.10.10:80/TCP     ClusterIP       test/http-service                 http       10.244.2.1:8080/TCP                Done
192.168.10.10:8080/TCP   LocalRedirect   test/lrp-service:local-redirect                                                 Done
[1001::1]:80/TCP         ClusterIP       test/http-service                 http       [2001::1]:8080/TCP                 Done
[1001::1]:8080/TCP       LocalRedirect   test/lrp-service:local-redirect                                                 Done

-- backends-initial.table --
Service             Address               Source   Priority   State    PortNames   NodeName
test/http-service   10.244.2.1:8080/TCP   k8s      4          active   http        testnode
test/http-service   [2001::1]:8080/TCP    k8s      4          active   http        testnode
-- backends-lrp.table --
Service             Address               Source   Priority   State    PortNames   NodeName
test/http-service   10.244.2.1:8080/TCP   k8s      4          active   http        testnode
test/http-service   [2001::1]:8080/TCP    k8s      4          active   http        testnode

